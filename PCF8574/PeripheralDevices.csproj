<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>PeripheralDevices</AssemblyName>
    <RootNamespace>PeripheralDevices</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <PackageId>Wastegate.Framework.Peripheral</PackageId>
    <Version>1.0.0</Version>
    <Authors>Wastegate</Authors>
    <Description>Библиотека для работы с периферийными устройствами PCF8574 и PCF8575.</Description>
    <PackageTags>UWP Linux Raspberry I2C GPIO</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/wastegate711/Wastegate.Framework.Peripheral</PackageProjectUrl>
    <PackageIcon>images/west-logos_white.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Device.Gpio" Version="3.2.0" />
    <Content Include="..\west-logos_white.png" Pack="true" PackagePath="images\west-logos_white.png" />
    <None Include="..\README.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>
</Project>
